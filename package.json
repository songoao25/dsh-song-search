{
  "name": "dsh-song-search",
  "version": "0.4.0",
  "description": "DeepSeek Harness (DSH) 插件：接入主流网页/AI 搜索服务 + 设置「搜索服务」页（图形界面选择搜索商、填写钥匙和自定义搜索设置，符合 Apple HIG）。零 DSH 内部依赖，直接调用各服务商官方 REST API。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node tests/run-all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "license": "MIT",
  "author": "SONGOAO25"
}
